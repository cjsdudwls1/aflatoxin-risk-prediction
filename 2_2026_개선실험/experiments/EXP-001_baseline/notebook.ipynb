   "source": [
    "## 시계열 timesteps를 50일로 변환"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
    },
    "execution": {
     "iopub.execute_input": "2026-05-22T00:51:21.445554Z",
     "iopub.status.busy": "2026-05-22T00:51:21.445313Z",
     "iopub.status.idle": "2026-05-22T00:51:21.790266Z",
     "shell.execute_reply": "2026-05-22T00:51:21.789798Z"
    },
    "executionInfo": {
